---
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';
import { experienceInWords } from '../utils/experience.js';
import { localized, useTranslations } from '../i18n/ui.js';

const { data, resume, locale = 'es' } = Astro.props;
const t = useTranslations(locale);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const name = data?.name;
const profilepic = `${base}/images/${data?.image}`;
// The bio keeps a {{years}} token so the copy stays editable in the data file
// while the count itself is derived from the start date.
const bio = (localized(data?.bio, locale) ?? '').replaceAll(
  '{{years}}',
  experienceInWords(locale),
);
const city = data?.address?.city;
const state = localized(data?.address?.state, locale);
const phones = data?.phones ?? [];
const email = data?.email;
const resumeDownload = localized(data?.resumedownload, locale);
const quote = data?.quote;
const languages = (resume?.spokenLanguages ?? []).map((item) =>
  [
    localized(item.language, locale),
    localized(item.level, locale),
    item.certificate && `(${item.certificate})`,
  ]
    .filter(Boolean)
    .join(' '),
);

// Phone and email ship base64-encoded and are assembled on click. This is not
// encryption — a determined scraper can decode it — but it does keep the plain
// values out of the HTML, which is what naive address harvesters read.
const encode = (value) => Buffer.from(String(value), 'utf8').toString('base64');

const details = [
  { icon: 'fa6-solid:user', label: name },
  {
    icon: 'fa6-solid:location-dot',
    label: [city, state].filter(Boolean).join(', '),
  },
  // The WhatsApp number opens a chat; any other number dials.
  ...phones.map((phone) =>
    phone.whatsapp
      ? {
          icon: 'fa6-brands:whatsapp',
          reveal: t('about.showWhatsapp'),
          value: encode(phone.number),
          scheme: 'whatsapp',
        }
      : {
          icon: 'fa6-solid:phone',
          reveal: t('about.showPhone'),
          value: encode(phone.number),
          scheme: 'tel',
        },
  ),
  {
    icon: 'fa6-solid:envelope',
    reveal: t('about.showEmail'),
    value: encode(email),
    scheme: 'mailto',
  },
  ...languages.map((label) => ({ icon: 'fa6-solid:language', label })),
];
---

<Section id="about" eyebrow={t('about.eyebrow')} title={t('about.title')}>
  <div class="grid gap-10 md:grid-cols-[auto_1fr] md:gap-12">
    <div class="mx-auto md:mx-0">
      <div class="glass rounded-glass p-2">
        <img
          class="size-40 rounded-[calc(var(--radius-glass)-0.25rem)] object-cover sm:size-48"
          src={profilepic}
          alt={t('about.photo', { name })}
          width="192"
          height="192"
          loading="lazy"
        />
      </div>
    </div>

    <div>
      <p class="text-base/8 text-white/75">{bio}</p>

      {
        quote && (
          <figure class="mt-6 border-l-2 border-accent-400/60 pl-4">
            <blockquote class="text-sm/7 text-white/70 italic">
              “{localized(quote.text, locale)}”
            </blockquote>
            <figcaption class="mt-1 text-xs text-white/45">
              — {quote.author}
            </figcaption>
          </figure>
        )
      }

      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {
          details.map((detail) => (
            <li>
              <div class="glass flex items-center gap-3 rounded-2xl px-4 py-3">
                <Icon
                  name={detail.icon}
                  class="size-4 shrink-0 text-accent-400"
                />
                {detail.value ? (
                  <button
                    type="button"
                    data-reveal
                    data-value={detail.value}
                    data-scheme={detail.scheme}
                    class="cursor-pointer truncate text-sm text-white/60 underline decoration-dotted underline-offset-4 hover:text-accent-300"
                  >
                    {detail.reveal}
                  </button>
                ) : (
                  <span class="truncate text-sm text-white/80">
                    {detail.label}
                  </span>
                )}
              </div>
            </li>
          ))
        }
      </ul>

      <a
        href={resumeDownload}
        class="glass-strong mt-8 inline-flex items-center gap-2.5 rounded-full px-6 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:text-accent-300"
      >
        <Icon name="fa6-solid:download" class="size-4" />
        {t('about.download')}
      </a>
    </div>
  </div>
</Section>

<script>
  // Swap the "Ver teléfono" / "Show phone" button for the real value on click. The
  // value only exists decoded once the visitor asks for it.
  document.querySelectorAll('[data-reveal]').forEach((button) => {
    button.addEventListener(
      'click',
      () => {
        const value = atob(button.dataset.value ?? '');
        const scheme = button.dataset.scheme;
        const href =
          scheme === 'tel'
            ? `tel:${value.replace(/\s/g, '')}`
            : scheme === 'whatsapp'
              ? `https://wa.me/${value.replace(/\D/g, '')}`
              : `${scheme}:${value}`;

        const link = document.createElement('a');
        link.href = href;
        if (scheme === 'whatsapp') {
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
        }
        link.textContent = value;
        link.className = 'truncate text-sm text-white/80 hover:text-accent-300';
        button.replaceWith(link);
      },
      { once: true },
    );
  });
</script>
