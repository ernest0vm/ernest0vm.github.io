---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Highlights from './Highlights.astro';
import Timeline from './Timeline.astro';
import Skills from './Skills.astro';
import Portfolio from './Portfolio.astro';
import Footer from './Footer.astro';
import resume from '../data/resume.json';
import {
  formatMonth,
  formatPeriod,
  useList,
  useTranslations,
} from '../i18n/index.js';
import { metaDescription, profileJsonLd } from '../utils/seo.js';
import { getAbsoluteLocaleUrl } from 'astro:i18n';

const { locale = 'es' } = Astro.props;
const t = useTranslations(locale);
const c = useTranslations(locale, 'content');
const list = useList(locale);

const work = resume.work.map((job) => ({
  heading: job.company,
  subheading: job.title,
  meta: formatPeriod(job.start, job.end, locale, t('date.present')),
  description: c(`work.${job.id}.summary`),
  bullets: list(`work.${job.id}.highlights`),
  logo: job.logo,
}));

const education = resume.education.map((item) => ({
  heading: item.school,
  subheading: c(`education.${item.id}.degree`),
  meta: formatMonth(item.graduated, locale),
  note: item.license && t('education.license', { number: item.license }),
  description: c(`education.${item.id}.description`),
  logo: item.logo,
}));

// A short, search-sized summary rather than the full bio, plus structured
// data for search engines and AI assistants (see src/utils/seo.js).
const description = metaDescription(locale);
const jsonLd = profileJsonLd(locale, getAbsoluteLocaleUrl(locale));
---

<Layout
  locale={locale}
  title={`${resume.name} — ${resume.role}`}
  description={description}
  jsonLd={jsonLd}
>
  <Nav locale={locale} />

  <main>
    <Hero locale={locale} />
    <About locale={locale} />
    <Highlights locale={locale} />
    <Timeline
      id="work"
      eyebrow={t('work.eyebrow')}
      title={t('work.title')}
      items={work}
    />
    <Timeline
      id="education"
      eyebrow={t('education.eyebrow')}
      title={t('education.title')}
      items={education}
    />
    <Skills locale={locale} />
    <Portfolio locale={locale} />
  </main>

  <Footer locale={locale} />
</Layout>
