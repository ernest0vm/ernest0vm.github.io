---
const { id, eyebrow, title, lead } = Astro.props;
---

<section id={id} class="relative scroll-mt-24 px-6 py-24 sm:py-32">
  <div class="mx-auto max-w-5xl">
    <header class="max-w-2xl">
      {eyebrow && (
        <p class="text-xs font-semibold tracking-[0.2em] text-accent-400 uppercase">
          {eyebrow}
        </p>
      )}
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        {title}
      </h2>
      {lead && <p class="mt-4 text-base/7 text-white/60">{lead}</p>}
    </header>

    <div class="mt-12">
      <slot />
    </div>
  </div>
</section>
