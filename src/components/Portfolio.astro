---
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';

const { data } = Astro.props;
const projects = data?.projects ?? [];
---

<Section
  id="portfolio"
  eyebrow="Portafolio"
  title="Trabajo como desarrollador móvil"
  lead="Aplicaciones en producción y prototipos, en Flutter, React Native, Xamarin y Kotlin."
>
  <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      projects.map((project) => (
        <li>
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group glass flex h-full flex-col overflow-hidden rounded-glass transition hover:-translate-y-1"
          >
            <div class="relative overflow-hidden bg-ink-900">
              <img
                src={project.image}
                alt={project.title}
                class="h-72 w-full object-cover object-top transition duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div
                class="absolute inset-0 bg-gradient-to-t from-ink-950 via-ink-950/20 to-transparent"
                aria-hidden="true"
              />
            </div>

            <div class="flex flex-1 items-start justify-between gap-3 p-5">
              <div>
                <h3 class="text-sm font-semibold text-white group-hover:text-accent-300">
                  {project.title}
                </h3>
                <p class="mt-1 text-xs text-white/50">{project.category}</p>
              </div>
              <Icon
                name="fa6-solid:arrow-up-right-from-square"
                class="mt-0.5 size-3.5 shrink-0 text-white/30 transition group-hover:text-accent-300"
              />
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</Section>
