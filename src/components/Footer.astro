---
import { Icon } from 'astro-icon/components';
import resume from '../data/resume.json';
import { useTranslations } from '../i18n/index.js';

const { locale = 'es' } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="px-6 pt-10 pb-14">
  <!-- A 3-column grid rather than justify-between: with flex, the middle group
       lands wherever the two unequal outer items leave room, which pushed the
       social icons visibly right of centre. Equal columns centre them for real. -->
  <div class="glass mx-auto flex max-w-5xl flex-col items-center gap-6 rounded-glass px-6 py-8 sm:grid sm:grid-cols-3 sm:gap-4">
    <p class="order-2 text-xs text-white/40 sm:order-1 sm:justify-self-start">
      {`© ${year} ${resume.name}`}
    </p>

    <ul class="order-1 flex items-center gap-2 sm:order-2 sm:justify-self-center">
      {resume.social.map((network) => (
        <li>
          <a
            href={network.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={network.label}
            class="flex size-9 items-center justify-center rounded-full text-white/50 transition hover:bg-white/10 hover:text-accent-300"
          >
            <Icon name={network.icon} class="size-4" />
          </a>
        </li>
      ))}
    </ul>

    <a
      href="#home"
      aria-label={t('footer.top')}
      class="order-3 flex size-9 items-center justify-center rounded-full text-white/50 transition hover:bg-white/10 hover:text-accent-300 sm:justify-self-end"
    >
      <Icon name="fa6-solid:chevron-up" class="size-4" />
    </a>
  </div>
</footer>
