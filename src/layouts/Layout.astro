---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import { LOCALES, DEFAULT_LOCALE, useTranslations } from '../i18n/index.js';
import resume from '../data/resume.json';
import { OG_LOCALES, SITE } from '../utils/seo.js';
import {
  HEIGHT as OG_HEIGHT,
  WIDTH as OG_WIDTH,
} from '../pages/og/[lang].png.js';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const {
  locale = DEFAULT_LOCALE,
  title = 'Ernesto Valdez',
  description = '',
  jsonLd,
} = Astro.props;
const t = useTranslations(locale);

const canonical = getAbsoluteLocaleUrl(locale);
const ogImage = `${SITE}/og/${locale}.png`;
// rel="me" ties the page to the person's other profiles for search engines.
const profiles = resume.social.filter((network) => network.id !== 'whatsapp');

// Tell search engines the two pages are translations of each other, so each
// language ranks for its own audience instead of competing as duplicates.
const alternates = LOCALES.map((code) => ({
  code,
  href: getAbsoluteLocaleUrl(code),
}));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0d12" />
    <meta name="description" content={description} />
    <meta name="author" content={resume.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {profiles.map((network) => (
      <link rel="me" href={network.url} />
    ))}

    <!-- Link previews (LinkedIn, WhatsApp, Slack, X…) -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={resume.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    {LOCALES.filter((code) => code !== locale).map((code) => (
      <meta property="og:locale:alternate" content={OG_LOCALES[code]} />
    ))}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={t('meta.ogAlt')} />
    <meta property="profile:first_name" content={resume.name.split(' ')[0]} />
    <meta
      property="profile:last_name"
      content={resume.name.split(' ').slice(1).join(' ')}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t('meta.ogAlt')} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    <link rel="manifest" href={`${base}/manifest.json`} />
    <link rel="shortcut icon" href={`${base}/favicon.ico`} />
    <title>{title}</title>
    {alternates.map(({ code, href }) => (
      <link rel="alternate" hreflang={code} href={href} />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={getAbsoluteLocaleUrl(DEFAULT_LOCALE)}
    />
  </head>

  <body class="overflow-x-hidden">
    <a
      href="#about"
      class="sr-only rounded-full px-4 py-2 focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-999 focus:bg-white focus:text-ink-950"
    >
      {t('skip')}
    </a>

    <!-- Site-wide backdrop. Fixed, so it stays put while the page scrolls and
         every `glass` surface has something moving to reveal through it.
         Must live outside any isolated stacking context: an ancestor with
         `isolation: isolate` would become the backdrop root and clip what
         backdrop-filter is allowed to sample. -->
    <div
      id="site-backdrop"
      class="pointer-events-none fixed inset-0 -z-10"
      aria-hidden="true"
    >
      <div class="absolute -top-40 left-1/4 h-[38rem] w-[38rem] rounded-full bg-accent-500/20 blur-[100px]"></div>
      <div class="absolute right-0 bottom-1/4 h-[32rem] w-[32rem] rounded-full bg-violet-400/25 blur-[110px]"></div>
      <div id="particles-bg" class="absolute inset-0"></div>
    </div>

    <slot />

    <script>
      import { tsParticles } from '@tsparticles/engine';
      import { loadSlim } from '@tsparticles/slim';

      const still = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;

      async function initParticles() {
        await loadSlim(tsParticles);
        await tsParticles.load({
          id: 'particles-bg',
          options: {
            fullScreen: { enable: false },
            background: { color: 'transparent' },
            fpsLimit: 60,
            detectRetina: true,
            particles: {
              number: { value: 70, density: { enable: true } },
              color: { value: '#7fe9f5' },
              links: {
                enable: true,
                color: '#7fe9f5',
                distance: 130,
                opacity: 0.35,
                width: 1,
              },
              // Honour the OS setting: keep the constellation, drop the drift.
              move: { enable: !still, speed: 0.8 },
              opacity: { value: 0.5 },
              size: { value: { min: 1, max: 3 } },
            },
          },
        });
      }

      initParticles();
    </script>

    <script is:inline>
      // Unregister the service worker left behind by the old CRA build so
      // returning visitors don't get stuck on a cached version of the site.
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then((registrations) => {
          registrations.forEach((registration) => registration.unregister());
        });
      }
    </script>
  </body>
</html>
