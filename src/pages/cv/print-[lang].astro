---
/**
 * Print layout for the downloadable CV. scripts/build-cv.mjs builds this page
 * and prints it to PDF; it is never part of the public site.
 *
 * Deliberately independent of the site's look: plain scoped CSS, no Tailwind
 * and no global.css, and its labels come from src/i18n/<locale>/cv.json, not
 * the site's ui.json. Restyling the site neither changes the PDF nor needs to
 * regenerate it; only the data, the content/cv translations and this file do.
 */
import process from 'node:process';
import { Icon } from 'astro-icon/components';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import resume from '../../data/resume.json';
import {
  formatMonth,
  formatPeriod,
  useList,
  useTranslations,
} from '../../i18n/index.js';
import { experienceInWords } from '../../utils/experience.js';

// Served at /cv/print-es/ and /cv/print-en/: a bare /es/ segment would be
// taken by Astro's i18n routing as a prefixed default locale and answer 404.
export function getStaticPaths() {
  // The page prints phone and email in plain text, which must never ship with
  // the site (see "Datos de contacto" in CLAUDE.md). Only the PDF build sets
  // CV_PDF; a normal build emits no route at all.
  if (process.env.CV_PDF !== '1') return [];
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params;
const label = useTranslations(lang, 'cv');
const c = useTranslations(lang, 'content');
const list = useList(lang);
const { contact } = resume;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const bio = c('bio', { years: experienceInWords(lang) });
const location = [contact.city, c('state')].filter(Boolean).join(', ');
/** "https://github.com/ernest0vm/" -> "github.com/ernest0vm" */
const bare = (url) =>
  url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

const contacts = [
  ...contact.phones.map((phone) => ({
    icon: phone.whatsapp ? 'fa6-brands:whatsapp' : 'fa6-solid:phone',
    label: phone.number,
    href: phone.whatsapp
      ? `https://wa.me/${phone.number.replace(/\D/g, '')}`
      : `tel:${phone.number.replace(/\s/g, '')}`,
  })),
  {
    icon: 'fa6-solid:envelope',
    label: contact.email,
    href: `mailto:${contact.email}`,
  },
  { icon: 'fa6-solid:location-dot', label: location },
];

// WhatsApp is already in the contact row, so only the profile links go here.
const links = [
  { icon: 'fa6-solid:globe', href: getAbsoluteLocaleUrl(lang) },
  ...resume.social
    .filter((network) => network.id !== 'whatsapp')
    .map((network) => ({ icon: network.icon, href: network.url })),
];

const spoken = resume.languages.map(
  (item) =>
    `${c(`languages.${item.id}.name`)} ${item.cefr} · ${c(`languages.${item.id}.level`)}`,
);
const caption = (project) =>
  [
    c(`portfolio.${project.id}`),
    project.stack,
    project.retired && label('retired'),
  ]
    .filter(Boolean)
    .join(' · ');
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{label('title')} — {resume.name}</title>
  </head>
  <body>
    <main class="sheet">
      <header class="masthead">
        <span class="photo">
          <img
            src={`${base}/images/${resume.photo}`}
            alt=""
            width="104"
            height="104"
          />
        </span>
        <div class="identity">
          <h1>{resume.name}</h1>
          <p class="role">{resume.role}</p>
          <ul class="contacts">
            {contacts.map((item) => (
              <li>
                <Icon name={item.icon} class="icon" />
                {item.href ? <a href={item.href}>{item.label}</a> : item.label}
              </li>
            ))}
          </ul>
          <ul class="contacts links">
            {links.map((item) => (
              <li>
                <Icon name={item.icon} class="icon" />
                <a href={item.href}>{bare(item.href)}</a>
              </li>
            ))}
          </ul>
        </div>
      </header>

      <section>
        <h2>{label('profile')}</h2>
        <p>{bio}</p>
      </section>

      <section>
        <h2>{label('highlights')}</h2>
        <dl class="scale">
          {resume.scale.map((item) => (
            <div>
              <dt>{c(`scale.${item.id}.label`)}</dt>
              <dd>{c(`scale.${item.id}.value`)}</dd>
            </div>
          ))}
        </dl>
        <ul class="highlights">
          {resume.highlights.map((item) => (
            <li>
              <strong>{c(`highlights.${item.id}.title`)}.</strong>{' '}
              {c(`highlights.${item.id}.description`)}
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>{label('work')}</h2>
        {resume.work.map((job) => (
          <article class="entry">
            <div class="entry-head">
              <h3>
                {job.title} <span class="at">· {job.company}</span>
              </h3>
              <p class="when">
                {formatPeriod(
                  job.start,
                  job.end,
                  lang,
                  label('present'),
                ).replace(' - ', ' – ')}
              </p>
            </div>
            <p>{c(`work.${job.id}.summary`)}</p>
            {list(`work.${job.id}.highlights`).length > 0 && (
              <ul class="bullets">
                {list(`work.${job.id}.highlights`).map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </section>

      <section>
        <h2>{label('education')}</h2>
        {resume.education.map((item) => (
          <article class="entry">
            <div class="entry-head">
              <h3>
                {c(`education.${item.id}.degree`)}{' '}
                <span class="at">· {item.school}</span>
              </h3>
              <p class="when">{formatMonth(item.graduated, lang)}</p>
            </div>
            {item.license && (
              <p class="muted">
                {label('license')}: {item.license}
              </p>
            )}
          </article>
        ))}
      </section>

      <section class="keep">
        <h2>{label('skills')}</h2>
        <dl class="facts">
          <dt>{label('languages')}</dt>
          <dd>{resume.skills.map((item) => item.name).join(' · ')}</dd>
          <dt>{label('tools')}</dt>
          <dd>{resume.tools.map((item) => item.name).join(' · ')}</dd>
          {spoken.length > 0 && (
            <>
              <dt>{label('spoken')}</dt>
              <dd>{spoken.join(' · ')}</dd>
            </>
          )}
        </dl>
      </section>

      <section>
        <h2>{label('portfolio')}</h2>
        <ul class="apps">
          {resume.portfolio.map((project) => (
            <li>
              {project.url ? (
                <a class="app-name" href={project.url}>
                  {project.title}
                </a>
              ) : (
                <span class="app-name">{project.title}</span>
              )}
              <span class="muted">{caption(project)}</span>
            </li>
          ))}
        </ul>
      </section>

      {/* Pinned to the bottom of the last page by scripts/build-cv.mjs; until
        then (e.g. in dev) it simply follows the content. */}
      {resume.quote && (
        <figure class="closing-quote">
          <blockquote>“{c('quote')}”</blockquote>
          <figcaption>— {resume.quote.author}</figcaption>
        </figure>
      )}
    </main>
  </body>
</html>

<style is:global>
  /* Open Sans is the site's face too, served from /public/fonts. */
  @font-face {
    font-family: 'Open Sans';
    src: url('/fonts/opensans-regular.woff') format('woff');
    font-weight: 400;
  }
  @font-face {
    font-family: 'Open Sans';
    src: url('/fonts/opensans-semibold.woff') format('woff');
    font-weight: 600;
  }
  @font-face {
    font-family: 'Open Sans';
    src: url('/fonts/opensans-bold.woff') format('woff');
    font-weight: 700;
  }

  /* The masthead echoes the site's dark glass; the body is light so it reads
     and prints well. Accent text uses a deeper cyan than the site's, which
     would not hold contrast on white. */
  :root {
    --ink: oklch(0.21 0.017 260);
    --text: oklch(0.3 0.02 260);
    --muted: oklch(0.5 0.015 260);
    --rule: oklch(0.9 0.01 260);
    --accent: oklch(0.5 0.1 215);
    --accent-light: oklch(0.88 0.13 195);
    --violet: oklch(0.72 0.17 295);
  }

  @page {
    size: letter;
    margin: 12mm 14mm 14mm;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  /* Ligatures extract as single glyphs (ﬁ, ﬂ), so an ATS searching for
     "firmware" or "flags" would miss them. */
  body {
    font-variant-ligatures: none;
    font-family: 'Open Sans', sans-serif;
    font-size: 9.25pt;
    line-height: 1.42;
    color: var(--text);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  ul {
    list-style: none;
  }

  .masthead {
    display: flex;
    gap: 18px;
    align-items: center;
    padding: 18px 22px;
    border-radius: 14px;
    color: oklch(0.92 0.01 260);
    background:
      radial-gradient(
        circle at 88% 0%,
        color-mix(in oklab, var(--violet) 35%, transparent),
        transparent 55%
      ),
      radial-gradient(
        circle at 0% 100%,
        color-mix(in oklab, var(--accent-light) 22%, transparent),
        transparent 50%
      ),
      var(--ink);
  }

  .photo {
    flex-shrink: 0;
    width: 104px;
    height: 104px;
    overflow: hidden;
    border-radius: 50%;
    border: 2px solid color-mix(in oklab, white 35%, transparent);
  }

  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h1 {
    font-size: 21pt;
    font-weight: 700;
    line-height: 1.15;
    color: white;
  }

  .role {
    margin-top: 2px;
    font-size: 11pt;
    font-weight: 600;
    color: var(--accent-light);
  }

  /* Two equal columns spanning the whole masthead, for contacts and links
     alike, so both blocks line up and no space is left over on the right. */
  .identity {
    flex: 1;
    min-width: 0;
  }

  .contacts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px 20px;
    margin-top: 10px;
    font-size: 8.5pt;
  }

  .contacts.links {
    margin-top: 6px;
    color: oklch(0.8 0.01 260);
  }

  .contacts li {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .icon {
    width: 10px;
    height: 10px;
    color: var(--accent-light);
  }

  section {
    margin-top: 16px;
  }

  .keep {
    break-inside: avoid;
  }

  h2 {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 8px;
    font-size: 9pt;
    font-weight: 700;
    /* No letter-spacing: text extractors read spaced capitals as
       "E X P E R I E N C E", and an ATS would not find the section. */
    text-transform: uppercase;
    color: var(--accent);
    break-after: avoid;
  }

  h2::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--rule);
  }

  .sheet {
    position: relative;
  }

  .closing-quote {
    width: fit-content;
    max-width: 60%;
    margin: 20px 0 0 auto;
    padding-right: 10px;
    border-right: 2px solid var(--accent);
    text-align: right;
    color: var(--muted);
    break-inside: avoid;
  }

  .closing-quote blockquote {
    font-style: italic;
  }

  .closing-quote figcaption {
    margin-top: 2px;
    font-size: 8pt;
  }

  /* Set by scripts/build-cv.mjs for the second print pass, once it knows the
     page count: the sheet stretches to the end of the last page, and the
     quote leaves the flow for its bottom-right corner. --quote-space keeps
     the room it took in the first pass, so the page count cannot change.
     --page-content is the letter height minus the @page margins above. */
  .pinned .sheet {
    --page-content: calc(279.4mm - 12mm - 14mm);
    min-height: calc(var(--pages) * var(--page-content) - 1mm);
    padding-bottom: var(--quote-space);
  }

  .pinned .closing-quote {
    position: absolute;
    right: 0;
    bottom: 0;
    margin: 0;
  }

  .entry {
    break-inside: avoid;
  }

  /* A job with a bullet list may span pages, but only between bullets: kept
     whole, the longest entry would leave most of a page blank. */
  .entry:has(.bullets) {
    break-inside: auto;
  }

  .entry-head,
  .entry:has(.bullets) > p {
    break-after: avoid;
  }

  .bullets li {
    break-inside: avoid;
  }

  .entry + .entry {
    margin-top: 10px;
  }

  .entry-head {
    display: flex;
    gap: 12px;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2px;
  }

  h3 {
    font-size: 10pt;
    font-weight: 700;
    color: var(--ink);
  }

  .at {
    font-weight: 600;
    color: var(--accent);
  }

  .when {
    flex-shrink: 0;
    font-size: 8pt;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .muted {
    color: var(--muted);
  }

  .scale {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 8px;
  }

  /* Value above label, top-aligned so a wrapped label does not lift its
     value out of line with the others. */
  .scale div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    line-height: 1.25;
  }

  .scale dd {
    font-size: 13pt;
    font-weight: 700;
    color: var(--ink);
  }

  .scale dt {
    font-size: 7.5pt;
    color: var(--muted);
  }

  .highlights {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px 20px;
  }

  .highlights li {
    break-inside: avoid;
  }

  .highlights strong {
    color: var(--ink);
  }

  .bullets {
    margin-top: 3px;
    padding-left: 14px;
    list-style: disc;
  }

  .bullets li::marker {
    color: var(--accent);
  }

  .facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 4px 16px;
  }

  .facts dt {
    font-weight: 700;
    color: var(--ink);
  }

  .apps {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px 20px;
  }

  .apps li {
    break-inside: avoid;
  }

  .app-name {
    font-weight: 700;
    color: var(--ink);
  }

  a.app-name {
    color: var(--accent);
  }

  .app-name::after {
    content: ' — ';
    font-weight: 400;
    color: var(--muted);
  }
</style>
